PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/reconnect?replicaSet=rs0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
JWT_SECRET=your_random_secret_at_least_32_characters
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
FRONTEND_ORIGIN=http://localhost:5173

# Password recovery via authenticated SMTP (TLS required)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Reconnect <noreply@your-domain.com>

# Official social destinations; leave empty until confirmed
PUBLIC_GITHUB_URL=
PUBLIC_LINKEDIN_URL=
PUBLIC_TWITTER_URL=
PUBLIC_DISCORD_URL=
