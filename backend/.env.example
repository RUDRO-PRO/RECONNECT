PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/reconnect?replicaSet=rs0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
JWT_SECRET=your_random_secret_at_least_32_characters
# Primary (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Each API key setting accepts a comma-separated pool; one key rotates per request.
# Missing/failed providers fall through to the next, then to local matching.
# Fallback 1 (optional)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Fallback 2 (optional)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Fallback 3 (optional); local deterministic matching is always available
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional comma-separated custom frontend origins. Production and localhost are always allowed.
FRONTEND_ORIGIN=https://reconnect-network.vercel.app,http://localhost:5173
# Vercel automatically supplies VERCEL_URL / VERCEL_BRANCH_URL / VERCEL_PROJECT_PRODUCTION_URL.

# Password recovery via authenticated SMTP (TLS required)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Reconnect <noreply@your-domain.com>

# Official social destinations; leave empty until confirmed
PUBLIC_GITHUB_URL=
PUBLIC_LINKEDIN_URL=
PUBLIC_TWITTER_URL=
PUBLIC_DISCORD_URL=
