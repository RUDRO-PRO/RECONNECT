{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,backend/uploads/**,backend/tests/**,scripts/**,**/.env,**/.env.*,**/.cache/**,**/coverage/**,**/node_modules/{mongodb-memory-server,mongodb-memory-server-core,nodemon,@vercel/nft}/**,*.png,.git/**}"
    }
  },
  "routes": [
    {
      "src": "/api(?:/(.*))?",
      "dest": "/api/index.js?__path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
