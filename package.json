{
  "name": "reconnect",
  "version": "1.0.0",
  "description": "Talent Bridge - Bridging the Talent Gap Fullstack Monorepo",
  "scripts": {
    "backend:install": "npm --prefix backend install",
    "backend:start": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "build": "cd frontend && npm install --include=dev && npm run build",
    "start": "node backend/server.js",
    "check:function": "node scripts/check-function-size.cjs",
    "db:initialize": "node scripts/initialize-database.cjs",
    "test:load": "node scripts/load-test.mjs",
    "test:load:local": "node scripts/load-test-local.cjs"
  },
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@vercel/nft": "^1.11.1",
    "picomatch": "^4.0.7"
  }
}
